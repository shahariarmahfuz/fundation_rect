# Foundation Management System - Environment Variables Configuration

# Database
DATABASE_URL=postgresql://user:password@host:5432/dbname?sslmode=require

# Application Security
SECRET_KEY=your-secure-random-secret-key-min-32-chars
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# Cloudinary Storage Configuration (Backend server-side only)
# Do NOT expose CLOUDINARY_API_SECRET to the client or prefix with NEXT_PUBLIC_
CLOUDINARY_CLOUD_NAME=your_cloudinary_cloud_name
CLOUDINARY_API_KEY=your_cloudinary_api_key
CLOUDINARY_API_SECRET=your_cloudinary_api_secret

# Optional Next.js Public API Base (for standalone deployment)
# NEXT_PUBLIC_API_URL=http://localhost:8000
